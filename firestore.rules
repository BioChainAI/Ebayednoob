rules_version = '2';

// Security rules for the ebayednoob-github Firebase project.
// Deploy: Firebase console > Firestore Database > Rules (paste this file), or
//         `firebase deploy --only firestore:rules` from the repository root.
//
// Admins: the bootstrap admin below, plus any verified email that has a document at
// admins/{lowercased email}. Admins are managed from control-panel/ (Users & admins).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The session's email: the account email claim, or (when the project keeps one account
    // per sign-in provider and Google sessions carry no email claim) the provider identity.
    // map.get(key, default) keeps missing claims from failing the whole rule.
    function tokenEmail() {
      let t = request.auth.token;
      let claim = t.get('email', '');
      return claim is string && claim != ''
        ? claim.lower()
        : string(t.get('firebase', {}).get('identities', {}).get('email', [''])[0]).lower();
    }

    function verifiedEmail() {
      return signedIn() && tokenEmail() != '' && (
        request.auth.token.get('email_verified', false) == true
        || request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com');
    }

    function myEmail() {
      return tokenEmail();
    }

    // Optional: Firebase Auth UIDs that are always admins. Paste yours here (Control Panel →
    // Session shows it) if email-based admin access does not apply to your sign-in.
    function ownerUids() {
      return [];
    }

    // First admin. Google accounts for this address are always verified.
    function isBootstrapAdmin() {
      return (signedIn() && request.auth.uid in ownerUids())
        || (verifiedEmail() && myEmail() == 'ghoard1@gmail.com');
    }

    // An active grant in admins/{email}. Revoked grants stay in place with active == false.
    function hasAdminGrant() {
      let path = /databases/$(database)/documents/admins/$(myEmail());
      return exists(path) && get(path).data.get('active', true) == true;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (verifiedEmail() && hasAdminGrant());
    }

    // Every change to admins/{email} must be written together with a matching
    // adminLog entry (same batch), so the log is a complete history of admin access.
    function loggedAdminChange(email) {
      let d = request.resource.data;
      let logPath = /databases/$(database)/documents/adminLog/$(d.logId);
      return d.logId is string
        && d.active is bool
        && d.email == email
        && !exists(logPath)
        && existsAfter(logPath)
        && getAfter(logPath).data.target == email
        && (d.active
            ? getAfter(logPath).data.action in ['grant', 'bootstrap']
            : getAfter(logPath).data.action == 'revoke');
    }

    // A profile's stored email must be the session's real email (or empty), so the
    // Users list shows trustworthy addresses when an admin elevates someone.
    function honestEmail() {
      let e = request.resource.data.get('email', '');
      return e == '' || e.lower() == myEmail();
    }

    // ---- Usernames ----
    // A username change must reserve usernames/{lowercased} for this user in the same batch,
    // stamp usernameChangedAt with the server time, and respect the 7-day limit.
    function usernameFields() {
      return ['username', 'usernameLower', 'usernameChangedAt'];
    }

    function validUsernameChange(uid, before) {
      let d = request.resource.data;
      return d.username is string
        && d.username.matches('^[A-Za-z0-9_.-]{3,20}$')
        && d.usernameLower == d.username.lower()
        && d.usernameChangedAt == request.time
        && (before == null || !('usernameChangedAt' in before)
            || request.time > before.usernameChangedAt + duration.value(7, 'd'))
        && getAfter(/databases/$(database)/documents/usernames/$(d.usernameLower)).data.uid == uid;
    }

    // ---- Accounts ----

    // Each user owns their profile document (created by index.html and the Control Panel).
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && honestEmail()
        && (!request.resource.data.keys().hasAny(usernameFields())
            || validUsernameChange(uid, null));
      allow update: if signedIn() && request.auth.uid == uid
        && honestEmail()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(usernameFields())
            || validUsernameChange(uid, resource.data));
      allow delete: if isAdmin();
    }

    // Username reservations (public reads let anyone, including guests, check availability).
    match /usernames/{name} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name == name.lower()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // Tutorial progress written by the learning hubs:
    // artifacts/{appId}/users/{uid}/tutorial_statuses/progress
    match /artifacts/{appId}/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Admin grants, keyed by lowercased email. Never deleted: revoking sets active = false.
    match /admins/{email} {
      allow get: if (verifiedEmail() && email == myEmail()) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower() && loggedAdminChange(email);
      allow delete: if false;
    }

    // Append-only audit log of admin access changes. Entries are stamped with the
    // server time and the acting admin, and can never be edited or removed.
    match /adminLog/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.action in ['grant', 'revoke', 'bootstrap']
        && request.resource.data.target is string
        && request.resource.data.target == request.resource.data.target.lower()
        && request.resource.data.by == myEmail()
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.at == request.time
        && (request.resource.data.action != 'bootstrap'
            || (isBootstrapAdmin() && request.resource.data.target == myEmail()));
      allow update, delete: if false;
    }

    // ---- Research hub content ----
    // Public pages query with where('status', '==', 'published'); drafts are admin-only.

    match /publications/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /articles/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /feedItems/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Site settings: feedConfig (Stay Current), articleSync (article sources), studio.
    // Public read so the scheduled GitHub Action and visitors' refresh buttons can use them.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
